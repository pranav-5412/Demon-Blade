; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DemonBlade_codex"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
run/main_scene="res://scenes/episode_01/chapter_01_last_normal_day.tscn"

[autoload]

GameManager="*res://core/game_manager.gd"
SaveManager="*res://core/save_manager.gd"
SceneManager="*res://core/scene_manager.gd"
InputActions="*res://core/input_actions.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[input]

move_forward={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":87)]}
move_backward={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":68)]}
sprint={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194325)]}
jump={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":32)]}
interact={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":69)]}
attack={"deadzone": 0.5, "events": [Object(InputEventMouseButton,"button_index":1)]}
heavy_attack={"deadzone": 0.5, "events": [Object(InputEventMouseButton,"button_index":2)]}
dodge={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194324)]}
block={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":81)]}
lock_on={"deadzone": 0.5, "events": [Object(InputEventMouseButton,"button_index":3)]}
ability_1={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":49)]}
ability_2={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":50)]}
ability_3={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":51)]}
ability_4={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":52)]}
ability_5={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":53)]}
ability_6={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":54)]}
ability_7={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":55)]}
switch_character={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":84)]}
pause={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194305)]}

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
